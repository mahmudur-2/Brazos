# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Supabase CLI local state (may hold connection material)
supabase/.temp/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# local review/tooling artifacts
# Claude Code: shared config is versioned; local-only state is not.
.claude/settings.local.json
.claude/*.local.json
.claude/_claude_bak/
brazos-review.zip

# Supplied design comps (78MB of PNG/PDF/ZIP). Source material for the auth
# flow, not something the app builds against — the production copy of the one
# asset that ships from it lives in assets/brand/.
design-reference/

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# local launcher (embeds a live DB credential — must never be committed)
start.ps1

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
