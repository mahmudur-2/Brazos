# local review/tooling artifacts
# Claude Code: shared config is versioned; local-only state is not.
.claude/settings.local.json
.claude/*.local.json
.claude/_claude_bak/
.claude/run-lock.json
.claude/worktrees/
brazos-review.zip
# Per-run agent scratch: commit messages passed to `git commit -F`, verify
# logs, one-off probe scripts. Working material for a single run, never an
# authority for anything — nothing in the repo may cite it.
.audit-scratch/
# The commit-message file itself, at any depth, so it can never be committed by
# accident. A run cannot type its co-author trailer into `git commit -m`: the
# guard refuses any command whose text contains the word "claude" and cannot
# tell a credit line from an attempt to start a second, unguarded session. The
# message therefore travels to `git commit -F` as a file.
commit-msg.txt
# Dispatch launcher output (the launcher is archived): the session activity
# log and its exit-code file.
.audit-scratch/dispatch/

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# local launcher (embeds a live DB credential — must never be committed)
start.ps1

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# screenshot output folder (the harness is archived; the folder may linger locally)
.shots/

# owner's dated archive of cleaned-up local files (moved, never deleted)
_archive/

graphify-out/
