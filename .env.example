# Copy this file to ".env" and fill in your Supabase project values.
# The .env file is git-ignored and must NOT be committed.

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Your Supabase publishable key (starts with "sb_publishable_").
SUPABASE_KEY=

# ---------------------------------------------------------------------------
# RLS probe identities (scripts/rls-probe-offers.mjs)
# ---------------------------------------------------------------------------
# Three SEEDED test accounts the probe signs in as to prove that one worker
# cannot read another worker's offer on a shared job. They are fixtures, not
# real users: scripts/seed-phase-6.sql creates all three with one shared
# password, and phase6.workerb exists for no other purpose than being the
# probe's second worker.
#
# The probe is read-only — it signs in and SELECTs, and creates nothing. Leave
# these blank and the three authenticated cases report SKIPPED, which makes the
# run INCONCLUSIVE rather than green.
#
# A shell variable of the same name overrides the value here, so a one-off run
# against different identities needs no edit to the file.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY in .env — it bypasses every RLS policy in
# the project. Scripts that need it read it from the shell only.
PROBE_WORKER_A_EMAIL=phase6.worker@brazos.test
PROBE_WORKER_A_PASSWORD=
PROBE_WORKER_B_EMAIL=phase6.workerb@brazos.test
PROBE_WORKER_B_PASSWORD=
PROBE_CUSTOMER_EMAIL=phase6.customer@brazos.test
PROBE_CUSTOMER_PASSWORD=

# Optional. The probe otherwise discovers a job carrying live offers from BOTH
# probe workers by reading as the customer.
PROBE_JOB_ID=

# ---------------------------------------------------------------------------
# Phone (SMS one-time code) sign-in
# ---------------------------------------------------------------------------
# Which phone-auth provider the app uses. One of:
#
#   mock      Development only. Generates a six-digit code on the device and
#             shows it on the verify screen. Sends no text message and creates
#             no session — the flow ends by telling you to sign in with email.
#             Ignored by a release build, which falls back to "disabled".
#   supabase  The real thing. Requires Supabase Phone Auth to be provisioned
#             with an SMS provider first — see docs/phone-auth-activation.md.
#   disabled  Phone sign-in is switched off; the screens say so and point at
#             email and password.
#
# Unset means "mock" in development and "disabled" in a release, so shipping
# without deciding can never expose the mock code path.
#
# No SMS provider credential belongs in this file or anywhere else in the app.
# The Twilio Account SID, Auth Token and Verify Service SID are entered in the
# Supabase dashboard and never reach the client.
EXPO_PUBLIC_PHONE_AUTH_MODE=mock
