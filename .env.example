# Copy this file to ".env" and fill in your Supabase project values.
# The .env file is git-ignored and must NOT be committed.

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Your Supabase publishable key (starts with "sb_publishable_").
SUPABASE_KEY=

# ---------------------------------------------------------------------------
# Phone (SMS one-time code) sign-in
# ---------------------------------------------------------------------------
# Which phone-auth provider the app uses. One of:
#
#   mock      Development only. Generates a six-digit code on the device and
#             shows it on the verify screen. Sends no text message and creates
#             no session — the flow ends by telling you to sign in with email.
#             Ignored by a release build, which falls back to "disabled".
#   supabase  The real thing. Requires Supabase Phone Auth to be provisioned
#             with an SMS provider first — see docs/phone-auth-activation.md.
#   disabled  Phone sign-in is switched off; the screens say so and point at
#             email and password.
#
# Unset means "mock" in development and "disabled" in a release, so shipping
# without deciding can never expose the mock code path.
#
# No SMS provider credential belongs in this file or anywhere else in the app.
# The Twilio Account SID, Auth Token and Verify Service SID are entered in the
# Supabase dashboard and never reach the client.
EXPO_PUBLIC_PHONE_AUTH_MODE=mock
