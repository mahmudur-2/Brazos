{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "PowerShell(git push:*)",
      "Bash(git push --force:*)",
      "PowerShell(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(git push -f:*)",
      "Bash(git reset --hard:*)",
      "PowerShell(git reset --hard:*)",
      "Bash(git clean:*)",
      "PowerShell(git clean:*)",
      "Bash(git stash:*)",
      "PowerShell(git stash:*)",
      "Edit(/design-reference/**)",
      "Edit(/public/**)",
      "Edit(/hosting/**)",
      "Edit(/dist/**)",
      "Edit(/WEB_DEPLOYMENT.md)",
      "Edit(**/*.web.ts)",
      "Edit(**/*.web.tsx)",
      "Edit(/screens/LaunchScreen.tsx)",
      "Edit(/screens/WelcomeScreen.tsx)",
      "Edit(/screens/SignInScreen.tsx)",
      "Edit(/screens/EmailSignInScreen.tsx)",
      "Edit(/screens/CreateAccountScreen.tsx)",
      "Edit(/screens/EmailCreateAccountScreen.tsx)",
      "Edit(/screens/VerifyPhoneScreen.tsx)",
      "Edit(/screens/SetupScreen.tsx)",
      "Edit(/screens/LegalGateScreen.tsx)",
      "Edit(/screens/HomeScreen.tsx)",
      "Edit(/screens/BrowseJobsScreen.tsx)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.ps1"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.ps1"
            ]
          }
        ]
      }
    ]
  }
}
