{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "PowerShell(git push:*)",
      "Bash(git push --force:*)",
      "PowerShell(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(git push -f:*)",
      "Bash(git reset --hard:*)",
      "PowerShell(git reset --hard:*)",
      "Bash(git clean:*)",
      "PowerShell(git clean:*)",
      "Bash(git stash:*)",
      "PowerShell(git stash:*)",
      "Edit(/design-reference/**)",
      "Edit(/public/**)",
      "Edit(/hosting/**)",
      "Edit(/dist/**)",
      "Edit(/WEB_DEPLOYMENT.md)",
      "Edit(**/*.web.ts)",
      "Edit(**/*.web.tsx)",
      "Edit(/screens/LaunchScreen.tsx)",
      "Edit(/screens/WelcomeScreen.tsx)",
      "Edit(/screens/SignInScreen.tsx)",
      "Edit(/screens/EmailSignInScreen.tsx)",
      "Edit(/screens/CreateAccountScreen.tsx)",
      "Edit(/screens/EmailCreateAccountScreen.tsx)",
      "Edit(/screens/VerifyPhoneScreen.tsx)",
      "Edit(/screens/SetupScreen.tsx)",
      "Edit(/screens/LegalGateScreen.tsx)",
      "Edit(/screens/HomeScreen.tsx)",
      "Edit(/screens/BrowseJobsScreen.tsx)",

      "Bash(*avkighsiufeefyycbebf*)",
      "PowerShell(*avkighsiufeefyycbebf*)",

      "Read(./start.ps1)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./start.ps1)",
      "Edit(./.env)",
      "Edit(./.env.*)",

      "Edit(/.claude/**)",

      "Bash(psql:*)",
      "PowerShell(psql:*)",
      "Bash(pg_dump:*)",
      "Bash(pg_restore:*)",
      "Bash(pg_dumpall:*)",
      "Bash(supabase:*)",
      "PowerShell(supabase:*)",

      "Bash(claude)",
      "Bash(claude *)",
      "Bash(claude.exe)",
      "Bash(claude.exe *)",
      "PowerShell(claude)",
      "PowerShell(claude *)",
      "PowerShell(claude.exe *)",

      "PowerShell(Invoke-Expression *)",
      "Bash(*-EncodedCommand*)",
      "PowerShell(*-EncodedCommand*)",
      "Bash(*cmd /c*)",
      "Bash(*cmd /k*)",
      "Bash(node -e *)",
      "Bash(node --eval *)",
      "Bash(node -p *)",
      "Bash(python -c *)",
      "PowerShell(node -e *)",

      "Bash(*--amend*)",
      "PowerShell(*--amend*)",

      "Bash(git add .)",
      "Bash(git add -A)",
      "Bash(git add -A *)",
      "Bash(git add -u)",
      "Bash(git add -u *)",
      "Bash(git add --all*)",

      "Bash(git pull:*)",
      "PowerShell(git pull:*)",
      "Bash(git fetch:*)",
      "PowerShell(git fetch:*)",
      "Bash(git checkout:*)",
      "PowerShell(git checkout:*)",
      "Bash(git switch:*)",
      "PowerShell(git switch:*)",
      "Bash(git restore:*)",
      "PowerShell(git restore:*)",
      "Bash(git rebase:*)",
      "PowerShell(git rebase:*)",
      "Bash(git merge:*)",
      "PowerShell(git merge:*)",
      "Bash(git cherry-pick:*)",
      "PowerShell(git cherry-pick:*)",
      "Bash(git revert:*)",
      "PowerShell(git revert:*)",
      "Bash(git tag:*)",
      "PowerShell(git tag:*)",
      "Bash(git worktree:*)",
      "PowerShell(git worktree:*)",
      "Bash(git submodule:*)",
      "PowerShell(git submodule:*)",
      "Bash(git reset:*)",
      "PowerShell(git reset:*)",
      "Bash(git filter-branch:*)",
      "PowerShell(git filter-branch:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.ps1"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.ps1"
            ]
          }
        ]
      }
    ]
  }
}
