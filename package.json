{
  "name": "brazos",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.18.3",
    "@react-navigation/native": "^7.3.4",
    "@react-navigation/native-stack": "^7.17.6",
    "@sentry/react-native": "~7.2.0",
    "@stripe/stripe-react-native": "0.50.3",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~54.0.37",
    "expo-blur": "~15.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech-recognition": "3.1.3",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "expo-video": "~3.0.16",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "supabase": "^2.116.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "tsc --noEmit --pretty false --noUnusedLocals --noUnusedParameters",
    "test": "node --test tests/*.test.mjs",
    "eas-build-pre-install": "node scripts/eas-build-pre-install.mjs",
    "verify": "npm run lint && npm test",
    "db:reset": "npx supabase db reset --local",
    "db:types": "npx supabase gen types --local --lang typescript --schema public > types/database.ts",
    "db:test": "npx supabase test db --local supabase/tests",
    "fingerprint": "npx expo-updates fingerprint:generate",
    "release:testflight": "npx eas-cli@latest build --platform ios --profile production --auto-submit",
    "update:preview": "npx eas-cli@latest update --channel preview --environment preview"
  },
  "private": true,
  "allowScripts": {
    "@sentry/cli@2.55.0": true,
    "esbuild@0.23.1": true
  }
}
