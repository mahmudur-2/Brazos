@@ -0,0 +1,34 @@
+import { useCallback, useSyncExternalStore } from 'react';
+import type { JobFilterModel } from '../lib/jobFilters';
+import {
+  readSessionJobFilters,
+  subscribeSessionJobFilters,
+  writeSessionJobFilters,
+} from '../lib/jobFilterSession';
+import { useAuth } from './useAuth';
+
+/**
+ * 2026-09-28 (LUX-LIST-64 #64, audit M-25) — the worker's ONE filter memory
+ * (lib/jobFilterSession.ts), as state: the Map and the job list read and write
+ * the same model, and a change on one is the other's too.
+ */
+export function useSessionJobFilters(): [
+  JobFilterModel,
+  (next: JobFilterModel | ((prev: JobFilterModel) => JobFilterModel)) => void,
+] {
+  const { user } = useAuth();
+  const userId = user?.id ?? null;
+  const model = useSyncExternalStore(
+    subscribeSessionJobFilters,
+    () => readSessionJobFilters(userId),
+    () => readSessionJobFilters(userId)
+  );
+  const setModel = useCallback(
+    (next: JobFilterModel | ((prev: JobFilterModel) => JobFilterModel)) => {
+      const prev = readSessionJobFilters(userId);
+      writeSessionJobFilters(userId, typeof next === 'function' ? next(prev) : next);
+    },
+    [userId]
+  );
+  return [model, setModel];
+}
diff --git a/hooks/useSheetPresence.ts b/hooks/useSheetPresence.ts
new file mode 100644
--- /dev/null
+++ b/hooks/useSheetPresence.ts
@@ -0,0 +1,71 @@
+import { useEffect, useRef, useState } from 'react';
+import { Animated, Easing, useWindowDimensions, type ViewStyle } from 'react-native';
+import { USE_NATIVE_DRIVER } from '../lib/motion';
+import { useReducedMotion } from './useReducedMotion';
+
+/** How long the card takes to rise and to fall. */
+export const SHEET_OPEN_MS = 300;
+export const SHEET_CLOSE_MS = 240;
+
+/**
+ * 2026-09-29 (LUX-LIST-2 #3) — THE ONE WAY A SLIDE-UP SHEET PRESENTS.
+ *
+ * The operator, on "View all" beside POPULAR SERVICES: "it animates by bringing the shadow up while it
+ * goes up... it looks off.. i want the shadow to be instant the second you click". Every slide-up
+ * sheet was a `<Modal animationType="slide">` with its dim INSIDE the sliding content, so the dim
+ * travelled up the screen with the card. Now the Modal does not animate (`animationType="none"`):
+ *
+ * - OPENING: the dim covers the whole screen from the first frame (`dimVisible`), and only the card
+ *   rises (`cardStyle`).
+ * - CLOSING: the dim goes the moment the close begins (`dimVisible` false), the card falls, and only
+ *   then does the Modal unmount (`mounted` false).
+ * - REDUCE MOTION: the card fades in and out instead of sliding; the dim is instant either way.
+ *
+ * The card's motion is a transform or an opacity on the native driver — nothing runs on the JS thread
+ * per frame (120 Hz). One hook, three callers (ServicePickerSheet, CreateSheet, ui/primitives/Sheet):
+ * one implementation, never three copies (P3-31).
+ */
+export function useSheetPresence(visible: boolean): {
+  mounted: boolean;
+  dimVisible: boolean;
+  cardStyle: Animated.WithAnimatedValue<ViewStyle>;
+} {
+  const { height } = useWindowDimensions();
+  const reduced = useReducedMotion() === true;
+  const [mounted, setMounted] = useState(visible);
+  const progress = useRef(new Animated.Value(0)).current;
+  const mountedRef = useRef(mounted);
+  mountedRef.current = mounted;
+
+  useEffect(() => {
+    if (visible) {
+      setMounted(true);
+      progress.stopAnimation();
+      progress.setValue(0);
+      Animated.timing(progress, {
+        toValue: 1,
+        duration: reduced ? 160 : SHEET_OPEN_MS,
+        easing: Easing.out(Easing.cubic),
+        useNativeDriver: USE_NATIVE_DRIVER,
+      }).start();
+      return;
+    }
+    if (!mountedRef.current) return;
+    Animated.timing(progress, {
+      toValue: 0,
+      duration: reduced ? 140 : SHEET_CLOSE_MS,
+      easing: Easing.in(Easing.cubic),
+      useNativeDriver: USE_NATIVE_DRIVER,
+    }).start(({ finished }) => {
+      if (finished) setMounted(false);
+    });
+    // `reduced` is read at the moment of each transition; a change mid-flight waits for the next one.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [visible]);
+
+  const cardStyle: Animated.WithAnimatedValue<ViewStyle> = reduced
+    ? { opacity: progress }
+    : { transform: [{ translateY: progress.interpolate({ inputRange: [0, 1], outputRange: [height, 0] }) }] };
+
+  return { mounted, dimVisible: visible, cardStyle };
+}
diff --git a/hooks/useUnreadNotificationCount.ts b/hooks/useUnreadNotificationCount.ts
new file mode 100644
--- /dev/null
+++ b/hooks/useUnreadNotificationCount.ts
@@ -0,0 +1,30 @@
+import { useCallback, useState } from 'react';
+import { useFocusEffect } from '@react-navigation/native';
+import { useAuth } from './useAuth';
+import { fetchNotifications } from '../lib/notifications';
+
+/**
+ * How many of this account's notifications are unread — the one fact the Home bell's count and
+ * Profile's "Notifications" row both show (2026-09-29, LUX-LIST-2 #7), so the two can never
+ * disagree. Re-read each time the screen that asks comes into focus; a failed read counts nothing
+ * rather than guessing.
+ */
+export function useUnreadNotificationCount(): number {
+  const { user } = useAuth();
+  const [unread, setUnread] = useState(0);
+
+  useFocusEffect(
+    useCallback(() => {
+      let active = true;
+      if (!user) return;
+      fetchNotifications(user.id).then(({ data, error }) => {
+        if (active) setUnread(error ? 0 : data.filter((n) => !n.read_at).length);
+      });
+      return () => {
+        active = false;
+      };
+    }, [user?.id])
+  );
+
+  return unread;
+}
