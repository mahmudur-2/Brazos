@@ -0,0 +1,88 @@
+import { Pressable, StyleSheet, Text, View } from 'react-native';
+import { Ionicons } from '@expo/vector-icons';
+import { useMode, useModeSwitch } from '../modes/ModeProvider';
+import { radius, spacing, themedStyles, useThemeColors, type ColorPalette } from '../lib/theme';
+
+/**
+ * 2026-09-26 (the refresh, audit M-8) — THE MODE SWITCH'S STANDING HOME.
+ *
+ * One row, the same in both trees: it says which mode you are in and switches
+ * to the other through the same switchMode() the [+] sheet's row and Worker
+ * Home's pill call — so it confirms first and swaps the tree exactly as they
+ * do. It sits at the top of the Profile hub and under Account & safety's
+ * "One identity, two modes" card; the sheet row and the pill stay as the
+ * shortcuts they were.
+ */
+export function ModeSwitchRow() {
+  const { palette: colors, isDark } = useThemeColors();
+  const styles = stylesFor(colors);
+  const { mode } = useMode();
+  const { target, switching, switchToOtherMode } = useModeSwitch();
+  const targetLabel = target === 'worker' ? 'Switch to Worker' : 'Switch to Customer';
+
+  return (
+    <Pressable
+      onPress={() => void switchToOtherMode()}
+      disabled={switching}
+      style={({ pressed }) => [styles.row, pressed && styles.pressed]}
+      accessibilityRole="button"
+      accessibilityLabel={targetLabel}
+      accessibilityHint="Confirms first"
+      accessibilityState={{ disabled: switching }}
+    >
+      <View style={[styles.disc, isDark && styles.discDark]}>
+        <Ionicons name="swap-horizontal" size={18} color={colors.emerald} />
+      </View>
+      <View style={styles.copy}>
+        <Text style={styles.eyebrow}>
+          {mode === 'worker' ? 'YOU’RE IN WORKER MODE' : 'YOU’RE IN CUSTOMER MODE'}
+        </Text>
+        <Text style={styles.label}>{targetLabel}</Text>
+      </View>
+      <Text style={styles.hint}>confirms first</Text>
+    </Pressable>
+  );
+}
+
+const stylesFor = themedStyles((colors: ColorPalette) =>
+  StyleSheet.create({
+    row: {
+      flexDirection: 'row',
+      alignItems: 'center',
+      gap: spacing.md,
+      minHeight: 64,
+      paddingHorizontal: spacing.lg,
+      borderRadius: radius.lg,
+      borderWidth: 1,
+      borderColor: colors.border,
+      backgroundColor: colors.surface,
+    },
+    pressed: { opacity: 0.82 },
+    disc: {
+      width: 40,
+      height: 40,
+      borderRadius: 20,
+      alignItems: 'center',
+      justifyContent: 'center',
+      borderWidth: 1,
+      borderColor: colors.emerald,
+    },
+    discDark: { borderColor: colors.gold },
+    copy: { flex: 1, gap: 2 },
+    eyebrow: {
+      fontSize: 11,
+      fontWeight: '800',
+      letterSpacing: 1.2,
+      color: colors.gold,
+    },
+    label: {
+      fontSize: 15,
+      fontWeight: '700',
+      color: colors.ink,
+    },
+    hint: {
+      fontSize: 12,
