+++ b/lib/passwordReset.ts
@@ -0,0 +1,46 @@
+import { supabase } from './supabase';
+import { PASSWORD_RESET_REDIRECT, type RecoveryTokens } from './passwordResetLink';
+
+/**
+ * 2026-09-26 (the refresh, audit M-21) — FORGOT PASSWORD.
+ *
+ * The only sign-in that works today is email and password, and until now a
+ * forgotten password locked the account out for good. This is the whole of
+ * the recovery: Supabase's own reset email, a link back into the app on the
+ * app's scheme (lib/passwordResetLink.ts reads it), and one screen that sets
+ * the new password. Nothing here is a new credential and nothing is stored on
+ * the device beyond the session the link itself carries.
+ */
+export {
+  isRecoveryPending,
+  MIN_PASSWORD_LENGTH,
+  parseRecoveryLink,
+  PASSWORD_RESET_REDIRECT,
+  setRecoveryPending,
+  subscribeRecovery,
+  type RecoveryTokens,
+} from './passwordResetLink';
+
+/** Ask Supabase to email a reset link. The answer is the same whether or not
+ *  an account exists for the address — the server never says which. */
+export async function requestPasswordReset(email: string): Promise<{ error: { message: string } | null }> {
+  const { error } = await supabase.auth.resetPasswordForEmail(email.trim(), {
+    redirectTo: PASSWORD_RESET_REDIRECT,
+  });
+  return { error: error ? { message: error.message } : null };
+}
+
+/** Sign in with the link's own session, so the new password can be set. */
+export async function beginRecovery(tokens: RecoveryTokens): Promise<{ error: { message: string } | null }> {
+  const { error } = await supabase.auth.setSession({
+    access_token: tokens.accessToken,
+    refresh_token: tokens.refreshToken,
+  });
+  return { error: error ? { message: error.message } : null };
+}
+
+/** The new password, for the account the recovery session belongs to. */
+export async function completePasswordReset(password: string): Promise<{ error: { message: string } | null }> {
+  const { error } = await supabase.auth.updateUser({ password });
+  return { error: error ? { message: error.message } : null };
+}
diff --git a/lib/passwordResetLink.ts b/lib/passwordResetLink.ts
new file mode 100644
--- /dev/null
+++ b/lib/passwordResetLink.ts
@@ -0,0 +1,58 @@
+/**
+ * 2026-09-26 (the refresh, audit M-21) — the pure half of Forgot password: the
+ * redirect the reset email sends people to, reading the tokens off that link,
+ * and the one flag that says a recovery is waiting for its new password. No
+ * imports, so tests/passwordReset.test.mjs executes it directly. The calls to
+ * Supabase live beside it in lib/passwordReset.ts.
+ *
+ * THE REDIRECT IS AN ALLOW-LISTED URL. Supabase refuses to send a user to a
+ * redirect that is not on the project's Auth → URL Configuration list, so
+ * `brazos://reset-password` must be added there (staging and production, by
+ * the operator) — the local stack lists it in supabase/config.toml.
+ */
+export const PASSWORD_RESET_REDIRECT = 'brazos://reset-password';
+
+export type RecoveryTokens = { accessToken: string; refreshToken: string };
+
+/**
+ * The tokens a reset link carries, or null when the URL is not a reset link.
+ * Supabase's implicit flow puts them in the fragment —
+ * `brazos://reset-password#access_token=…&refresh_token=…&type=recovery` — and
+ * a link without `type=recovery` is not a recovery, whatever else it carries.
+ */
+export function parseRecoveryLink(url: string): RecoveryTokens | null {
+  if (!url.toLowerCase().startsWith(PASSWORD_RESET_REDIRECT)) return null;
+  const hash = url.indexOf('#');
+  const query = url.indexOf('?');
+  const raw = hash >= 0 ? url.slice(hash + 1) : query >= 0 ? url.slice(query + 1) : '';
+  const params = new URLSearchParams(raw);
+  if (params.get('type') !== 'recovery') return null;
+  const accessToken = params.get('access_token');
+  const refreshToken = params.get('refresh_token');
+  return accessToken && refreshToken ? { accessToken, refreshToken } : null;
+}
+
+/** The shortest password the form accepts — Supabase's own default minimum. */
+export const MIN_PASSWORD_LENGTH = 6;
+
+// ---- the one piece of state: a recovery is waiting for its new password ----
+type Listener = (pending: boolean) => void;
+let pending = false;
+const listeners = new Set<Listener>();
+
+export function isRecoveryPending(): boolean {
+  return pending;
+}
+
+export function setRecoveryPending(next: boolean): void {
+  if (pending === next) return;
+  pending = next;
+  listeners.forEach((listener) => listener(next));
+}
+
+export function subscribeRecovery(listener: Listener): () => void {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
diff --git a/tests/passwordReset.test.mjs b/tests/passwordReset.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/passwordReset.test.mjs
@@ -0,0 +1,57 @@
+// 2026-09-26 (the refresh, audit M-21) — Forgot password. The link the reset
+// email sends is read by lib/passwordResetLink.ts (executed here); the sign-in
+// screen asks for it without ever saying whether an account exists; the app
+// opens the new-password screen only for a real recovery link.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+const root = join(dirname(fileURLToPath(import.meta.url)), '..');
+const read = (path) => readFileSync(join(root, path), 'utf8');
+const link = await import(pathToFileURL(join(root, 'lib/passwordResetLink.ts')).href);
+
+test('a reset link is read only when it is one: the app scheme, type=recovery, both tokens', () => {
+  const good = 'brazos://reset-password#access_token=a.b.c&refresh_token=r1&expires_in=3600&type=recovery';
+  assert.deepEqual(link.parseRecoveryLink(good), { accessToken: 'a.b.c', refreshToken: 'r1' });
+  assert.deepEqual(
+    link.parseRecoveryLink('brazos://reset-password?access_token=x&refresh_token=y&type=recovery'),
+    { accessToken: 'x', refreshToken: 'y' },
+    'a query string carries the same tokens'
+  );
+  assert.equal(link.parseRecoveryLink('brazos://reset-password#access_token=a&refresh_token=r&type=signup'), null, 'not a recovery');
+  assert.equal(link.parseRecoveryLink('brazos://reset-password#access_token=a&type=recovery'), null, 'no refresh token');
+  assert.equal(link.parseRecoveryLink('brazos://payouts?from=return'), null, 'another app link');
+  assert.equal(link.parseRecoveryLink('https://evil.example/reset-password#access_token=a&refresh_token=r&type=recovery'), null, 'another host');
+});
+
+test('the recovery flag notifies its listeners once per change', () => {
+  const seen = [];
+  const stop = link.subscribeRecovery((value) => seen.push(value));
+  link.setRecoveryPending(true);
+  link.setRecoveryPending(true);
+  link.setRecoveryPending(false);
+  stop();
+  link.setRecoveryPending(true);
+  assert.deepEqual(seen, [true, false]);
+  link.setRecoveryPending(false);
+});
+
+test('sign-in asks for the link without saying whether the account exists', () => {
+  const src = read('screens/EmailSignInScreen.tsx');
+  assert.match(src, /accessibilityLabel="Forgot password\?"/);
+  assert.match(src, /requestPasswordReset\(trimmedEmail\)/);
+  assert.match(src, /If an account uses \$\{trimmedEmail\}, a reset link is on its way/);
+  assert.match(src, /secureTextEntry=\{!passwordShown\}/, 'the eye toggles only what the field renders');
+});
+
+test('the app opens the new-password screen only after a recovery link signed it in', () => {
+  const app = read('App.tsx');
+  assert.match(app, /const recovery = parseRecoveryLink\(url\);/);
+  assert.match(app, /beginRecovery\(recovery\)[\s\S]{0,160}setRecoveryPending\(true\)/);
+  assert.match(app, /if \(user && recoveryPending\) return <ResetPasswordScreen \/>;/);
+  const reset = read('lib/passwordReset.ts');
+  assert.match(reset, /resetPasswordForEmail\(email\.trim\(\), \{\s*redirectTo: PASSWORD_RESET_REDIRECT,/);
+  assert.match(read('supabase/config.toml'), /"brazos:\/\/reset-password"/, 'the local stack allows the redirect');
+});
