new file mode 100644
--- /dev/null
+++ b/components/DrawnCheck.tsx
@@ -0,0 +1,65 @@
+import { Animated, StyleSheet, View } from 'react-native';
+import { CHECK_LEGS, CHECK_STROKE, legBox, legTransform, MARK_CHECK } from './SuccessMark.shared';
+import { metricStyles } from '../lib/theme';
+
+/**
+ * 2026-09-28 (LUX-LIST-64 #42) — A CHECK THAT DRAWS ITSELF, at any size: the
+ * published mark's own two legs (components/SuccessMark.shared.tsx — the short
+ * leg, then the long, each a rounded bar growing from its start point), drawn
+ * in their MARK_CHECK box and scaled to the size asked for, so the Seal's tick
+ * and the live page's tile tick are the same drawing as the mark's. `progress`
+ * (0 → 1) is the caller's, on the native driver; a still check passes 1.
+ */
+export function DrawnCheck({
+  size,
+  color,
+  progress,
+}: {
+  size: number;
+  color: string;
+  progress: Animated.Value | number;
+}) {
+  const styles = stylesFor();
+  const scale = size / MARK_CHECK;
+  return (
+    <View style={{ width: size, height: size }} pointerEvents="none">
+      <View style={[styles.box, { transform: [{ scale }] }]}>
+        {CHECK_LEGS.map((leg) => {
+          const grow =
+            typeof progress === 'number'
+              ? Math.max(0, Math.min(1, (progress - leg.from) / (leg.to - leg.from)))
+              : progress.interpolate({ inputRange: [leg.from, leg.to], outputRange: [0.001, 1], extrapolate: 'clamp' });
+          return (
+            <Animated.View
+              key={leg.key}
+              style={[
+                styles.stroke,
+                legBox(leg),
+                { backgroundColor: color, transform: legTransform(leg, grow as unknown as number) },
+              ]}
+            />
+          );
+        })}
+      </View>
+    </View>
+  );
+}
+
+const stylesFor = metricStyles(() =>
+  StyleSheet.create({
+    // The legs' own box, scaled about its centre into the size asked for.
+    box: {
+      position: 'absolute',
+      width: MARK_CHECK,
+      height: MARK_CHECK,
+      left: '50%',
+      top: '50%',
+      marginLeft: -MARK_CHECK / 2,
+      marginTop: -MARK_CHECK / 2,
+    },
+    stroke: {
+      position: 'absolute',
+      borderRadius: CHECK_STROKE / 2,
+    },
+  })
+);
diff --git a/components/FocusRing.tsx b/components/FocusRing.tsx
new file mode 100644
--- /dev/null
+++ b/components/FocusRing.tsx
@@ -0,0 +1,100 @@
+import { useEffect, useRef } from 'react';
+import { Animated, StyleSheet, View } from 'react-native';
+import { useReducedMotion } from '../hooks/useReducedMotion';
+import { USE_NATIVE_DRIVER } from '../lib/motion';
+import { metricStyles, withAlpha } from '../lib/theme';
+
+/** How long the glow takes to come up and go down — the field's old crossfade. */
+export const FOCUS_RING_MS = 160;
+/** The soft ring outside the field (sim.html `.in:focus-within`, 3px at .14). */
+const HALO = 3;
+const HALO_ALPHA = 0.14;
+/** The field's own edge while typing — the accent at .55 over its 1pt rim. */
+const EDGE_ALPHA = 0.55;
+
+/**
+ * 2026-09-28 (LUX-LIST-64 #8) — THE FIELD YOU ARE TYPING IN GLOWS.
+ *
+ * sim.html's `.in:focus-within{border-color:rgba(126,226,180,.55);box-shadow:0
+ * 0 0 3px rgba(126,226,180,.14)}` in the app's own mint (the light token's green
+ * in light): the rim turns the accent at .55 and a soft 3pt ring at .14 shows
+ * around the field, only while it has focus. Drawn as two outlines laid over
+ * the field — its edge exactly over the field's own 1pt border, the ring 3pt
+ * outside it — and faded as ONE opacity on the native driver, so it rides the
+ * 120 Hz display thread and nothing lays out again. Reduce Motion: it appears
+ * and goes at once.
+ *
+ * Mount it as the LAST child of the bordered view (the field), which must not
+ * clip its children. `radius` is the field's corner; `borderWidth` its rim.
+ */
+export function FocusRing({
+  focused,
+  color,
+  radius,
+  borderWidth = 1,
+}: {
+  focused: boolean;
+  color: string;
+  radius: number;
+  borderWidth?: number;
+}) {
+  const styles = stylesFor();
+  const reducedMotion = useReducedMotion();
+  const progress = useRef(new Animated.Value(focused ? 1 : 0)).current;
+
+  useEffect(() => {
+    const animation = Animated.timing(progress, {
+      toValue: focused ? 1 : 0,
+      duration: reducedMotion ? 0 : FOCUS_RING_MS,
+      useNativeDriver: USE_NATIVE_DRIVER,
+    });
+    animation.start();
+    return () => animation.stop();
+  }, [focused, progress, reducedMotion]);
+
+  const edgeInset = -borderWidth;
+  const haloInset = -(borderWidth + HALO);
+  return (
+    <Animated.View pointerEvents="none" style={[styles.layer, { opacity: progress }]}>
+      <View
+        style={[
+          styles.outline,
+          {
+            top: haloInset,
+            left: haloInset,
+            right: haloInset,
+            bottom: haloInset,
+            borderRadius: radius + HALO + borderWidth,
+            borderWidth: HALO,
+            borderColor: withAlpha(color, HALO_ALPHA),
+          },
+        ]}
+      />
+      <View
+        style={[
+          styles.outline,
+          {
+            top: edgeInset,
+            left: edgeInset,
+            right: edgeInset,
+            bottom: edgeInset,
+            borderRadius: radius,
+            borderWidth,
+            borderColor: withAlpha(color, EDGE_ALPHA),
+          },
+        ]}
+      />
+    </Animated.View>
+  );
+}
+
+const stylesFor = metricStyles(() =>
+  StyleSheet.create({
+    layer: {
+      ...StyleSheet.absoluteFillObject,
+    },
+    outline: {
+      position: 'absolute',
+    },
+  })
+);
