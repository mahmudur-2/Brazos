{
  "expo": {
    "name": "BRAZOS",
    "slug": "BRAZOS",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "brazos",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brazos.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.brazos.app",
      "adaptiveIcon": {
        "backgroundColor": "#082F27",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Brazos needs access to your photos so you can add a photo of the finished work."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Brazos to use your location while using the app to show work near you on the map."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Brazos to use the microphone so you can send voice messages in chat."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F4D3A"
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "c870820e-40cf-4367-9ae5-3eb2c6c8c481"
      }
    },
    "owner": "mah_r2",
    "updates": {
      "url": "https://u.expo.dev/c870820e-40cf-4367-9ae5-3eb2c6c8c481"
    }
  }
}
