{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_APP_VARIANT": "development",
        "EXPO_PUBLIC_PHONE_AUTH_MODE": "mock",
        "EXPO_PUBLIC_PAYMENTS_MODE": "disabled"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_APP_VARIANT": "preview",
        "EXPO_PUBLIC_PHONE_AUTH_MODE": "supabase",
        "EXPO_PUBLIC_PAYMENTS_MODE": "stripe"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_APP_VARIANT": "production",
        "EXPO_PUBLIC_PHONE_AUTH_MODE": "supabase",
        "EXPO_PUBLIC_PAYMENTS_MODE": "stripe"
      }
    },
    "e2e-test": {
      "distribution": "internal",
      "environment": "preview",
      "withoutCredentials": true,
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_APP_VARIANT": "preview",
        "EXPO_PUBLIC_PHONE_AUTH_MODE": "supabase",
        "EXPO_PUBLIC_PAYMENTS_MODE": "stripe"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
